# 前端环境变量模板
# 使用方式：复制本文件为 .env.development（开发环境），按需修改
# cp .env.example .env.development

# dev server 绑定主机（默认 localhost）
VITE_DEV_HOST=localhost

# dev server 监听端口（默认 8080）
VITE_DEV_PORT=8080

# 启动后是否自动打开浏览器：true / false（默认 true）
VITE_DEV_OPEN=true

# 开发代理指向的后端地址，解决跨域；/api、/ws、/health、/admin、/media 均代理至此（默认 http://127.0.0.1:8000）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
