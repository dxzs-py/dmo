# ============================================================
# Django_xm 环境变量示例
# ------------------------------------------------------------
# 真相源:
#   Django_xm/apps/core/config.py    (ProjectSettings，项目级配置)
#   Django_xm/apps/ai_engine/config.py (AISettings，AI 引擎配置)
# 优先级: 环境变量 > .env 文件 > Pydantic 默认值
# 约定: [必填] 缺失将启动失败；[可选] 有默认值，按需覆盖；
#       所有密钥仅留占位符，严禁提交真实密钥
# ============================================================

# ── 运行环境分发 [可选] ─────────────────────────────────────────
# prod / production → settings/prod.py；其他或缺省 → settings/dev.py
# python manage.py test 自动路由到 settings/test.py（无需配置）
DJANGO_ENV=development

# ── 核心安全 ────────────────────────────────────────────────────
# [必填] Django 密钥，生产必须更换
SECRET_KEY=your-secret-key-here-change-in-production
# [可选] JWT 独立签名钥：留空/删除本行 = 沿用 SECRET_KEY（不破坏现有登录态）；
# 生产可设置以与 SECRET_KEY 解耦，二者轮换互不影响
JWT_SIGNING_KEY=
# [可选] 调试模式；开发环境需显式 True，生产保持 False
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
SESSION_COOKIE_AGE=604800

# ── 数据库 [必填] ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=langchain
# [可选] Checkpointer/Store 直连串；缺省由 DB_* 拼接
CHECKPOINTER_POSTGRES_URI=

# ── Redis / 缓存 [可选] ─────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CHAT_URL=redis://127.0.0.1:6379/2
REDIS_PASSWORD=
REDIS_DEFAULT_TIMEOUT=300
REDIS_CHAT_TIMEOUT=3600

# ── Celery [可选] ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/4
CELERY_TASK_TIME_LIMIT=1800
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ── 服务器 / 应用 / 日志 [可选] ─────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=True
APP_NAME=DX-Study-Agent
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── 数据目录 [可选] ─────────────────────────────────────────────
DATA_DIR=data
DATA_UPLOADS_PATH=data/uploads

# ── 邮件 [可选] ─────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# ── 上传限制 / 速率限制 [可选] ──────────────────────────────────
UPLOAD_MAX_MEMORY_SIZE_MB=10
RATE_LIMIT_RPM=60
RATE_LIMIT_RPS=1.0
RATE_LIMIT_MAX_CONCURRENCY=10

# ── JWT 有效期 [可选] ───────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_DAYS=3
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── LLM 提供商 ──────────────────────────────────────────────────
# [可选] 按所用提供商填写；非 debug 模式至少需要 OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=
OPENAI_STREAMING=True
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
BAIDU_QIANFAN_API_KEY=
BAIDU_QIANFAN_API_BASE=https://qianfan.baidubce.com/v2
BAIDU_QIANFAN_MODEL=ernie-3.5-8k

# ── 搜索 / 地图工具 [可选] ──────────────────────────────────────
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
AMAP_KEY=

# ── Ollama 本地模型 [可选] ──────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3

# ── Embedding / 分块 / 向量库 [可选] ────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_PATH=data/indexes
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=langchain_xm

# ── 检索器 [可选] ───────────────────────────────────────────────
RETRIEVER_SEARCH_TYPE=similarity
RETRIEVER_K=4
RETRIEVER_SCORE_THRESHOLD=0.5
RETRIEVER_FETCH_K=20
RETRIEVER_COMPREHENSIVE_K=6
RETRIEVER_USE_MULTI_QUERY=True
RETRIEVER_INTENT_CLASSIFICATION_ENABLED=True
RETRIEVER_MAP_REDUCE_BATCH_SIZE=4

# ── RAG Pipeline [可选] ─────────────────────────────────────────
RAG_SCORE_THRESHOLD=0.7
RAG_DEGRADED_THRESHOLD=0.4
RAG_INITIAL_K=6
RAG_DEGRADED_K=12
RAG_KEYWORD_MAX=5
RAG_KEYWORD_K=3
RAG_RERANK_TOP_N=6
RAG_FULLTEXT_TOKEN_THRESHOLD=5000
RAG_MAX_DOCS_IN_RESULT=10
RAG_MAX_DOC_CONTENT_LENGTH=800
RAG_QUALITY_RETRIEVAL_THRESHOLD=0.5
RAG_QUALITY_GENERATION_THRESHOLD=0.6
RAG_MAX_RETRY_COUNT=1
RAG_RRF_CONSTANT=60
RAG_AGENT_MAX_ITERATIONS=10
RAG_AGENT_RETURN_SOURCE_DOCUMENTS=True

# ── Agent [可选] ────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=15
AGENT_MAX_EXECUTION_TIME=
# 子代理最大嵌套深度（0=主 agent，3=曾孙 agent）
AGENT_MAX_DEPTH=3

# ── Checkpointer / Store / 摘要 / 缓存 [可选] ───────────────────
CHECKPOINTER_BACKEND=postgres
CHECKPOINTER_REDIS_CACHE_ENABLED=False
CHECKPOINTER_REDIS_TTL=1800
CHECKPOINTER_REDIS_LOCK_TTL=5
STORE_ENABLED=False
STORE_BACKEND=postgres
SUMMARIZATION_TRIGGER_TOKENS=4000
SUMMARIZATION_KEEP_MESSAGES=20
AGENT_CACHE_ENABLED=False
LLM_CACHE_ENABLED=False
LLM_CACHE_TYPE=memory

# ── Guardrails [可选] ───────────────────────────────────────────
GUARDRAILS_ENABLED=False
GUARDRAILS_STRICT_MODE=False
GUARDRAILS_ENABLE_PII=False
GUARDRAILS_ENABLE_HUMAN_IN_LOOP=False
GUARDRAILS_MAX_MESSAGE_COUNT=100
GUARDRAILS_BLOCKED_TOOLS=

# ── LangSmith 追踪 [可选] ───────────────────────────────────────
# 启用需同时设置 LANGSMITH_TRACING=True 与 LANGSMITH_API_KEY
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain_xm
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 工具调用防护 [可选] ─────────────────────────────────────────
TOOL_USAGE_DEDUP_WINDOW_SECONDS=30
TOOL_USAGE_DEDUP_CACHE_SIZE=1000
TOOL_USAGE_RATE_LIMIT_MAX=30
TOOL_USAGE_RATE_LIMIT_WINDOW=60
TOOL_USAGE_SOFT_WARNING_THRESHOLD=0.5
TOOL_USAGE_HARD_STOP_THRESHOLD=0.9
TOOL_USAGE_SAME_PATH_MAX=6
TOOL_USAGE_SAME_PATH_DIFF_RATIO=0.05
TOOL_USAGE_BLOCKED_CONSECUTIVE_MAX=2
TOOL_USAGE_GENERAL_DEDUP_ENABLED=True
TOOL_USAGE_SAME_RESOURCE_MAX=6

# ── Docker 沙箱执行层 [可选] ────────────────────────────────────
# true 时 HIGH 级工具调用在 Docker 容器内执行（需本机 Docker）
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
# bridge=容器可访问宿主机与外网；none=完全断网隔离
SANDBOX_NETWORK=none
SANDBOX_SESSION_TIMEOUT=3600

# ── 附件治理 [可选] ─────────────────────────────────────────────
ATTACHMENT_DEFAULT_RETENTION_DAYS=30
ATTACHMENT_CLEANUP_HOUR=3
ATTACHMENT_STORAGE_WARNING_THRESHOLD=80
ATTACHMENT_STORAGE_CRITICAL_THRESHOLD=95
ATTACHMENT_DEDUP_ENABLED=True
ATTACHMENT_MAX_TOTAL_SIZE_MB=5120

# ── MCP [可选] ──────────────────────────────────────────────────
# 覆盖系统级 MCP Server 列表（JSON 数组；"[]" 表示禁用全部系统级 Server）
MCP_SYSTEM_SERVERS_JSON=
# Windows 下 npx/node 不在 PATH 时的备选路径
NPM_NPX_PATH=
NPM_NPX_ALT_PATH=
NODE_PATH=

# ── 字段加密 [生产必填] ─────────────────────────────────────────
# EncryptedCharField（Fernet）加密钥，生成:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── 其他 [可选] ─────────────────────────────────────────────────
# 置为 1/true 跳过 loguru 初始化
DISABLE_LOGURU=
