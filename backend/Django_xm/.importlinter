# import-linter 架构契约（治理接线：remediate-agent-audit-findings A2，2026-10-05）
#
# 现状：存在 3 处已知硬环，本批次不破环，只让检查工具真实生效并如实暴露：
#   环1 {ai_engine, context_manager}
#   环2 {ai_engine, knowledge}          —— settings_views 与 knowledge 索引/Embedding 深度耦合
#   环3 agent_hub <-> research          —— 业务互依（+ research -> chat 软边）
# 因此 lint-imports 当前必然 violated（预期失败，非回归）；本检查的目的是"防新增环"：
# 破环批次（批E/后续）完成前，新增环边会推高 violated 边数，review 时对照本文件豁免清单核查。
#
# 豁免原则：只精确豁免"已决策保留"的模块对（每条附注释），禁止整包/整环豁免；
# 豁免条目若与代码脱节（no match）会导致 import-linter 直接拒绝运行，必须随代码同步清理。
[importlinter]
root_package = Django_xm

[importlinter:contract:common-not-dependent-on-apps]
name = common 基础层禁止依赖 apps 业务层
type = forbidden
source_modules =
    Django_xm.common
forbidden_modules =
    Django_xm.apps

[importlinter:contract:ai-engine-not-dependent-on-agent-hub]
name = ai_engine 底层引擎禁止依赖 agent_hub 业务层（graph 工厂经注册注入实现依赖倒置）
type = forbidden
source_modules =
    Django_xm.apps.ai_engine
forbidden_modules =
    Django_xm.apps.agent_hub

[importlinter:contract:ai-engine-not-dependent-on-domain-apps]
name = ai_engine 引擎层禁止依赖 research/knowledge/learning 业务应用（依赖倒置：任务取消检查/子代理提示词/Embedding 缓存包装均由调用方注入）
type = forbidden
source_modules =
    Django_xm.apps.ai_engine
forbidden_modules =
    Django_xm.apps.research
    Django_xm.apps.knowledge
    Django_xm.apps.learning
ignore_imports =
    # 待后续批次（批E）：settings_views（AI 设置 API）与 knowledge 索引/Embedding 服务
    # 深度耦合，拆分需将相关视图整体迁移至 knowledge app（涉及 URL 与前端契约），
    # 本批次仅精确豁免以下模块对。
    # 注意：settings_views -> knowledge.services.cross_app（get_index_manager，
    # settings_views.py:27）【未豁免】——保留为环2 {ai_engine,knowledge} 的可见违反，
    # 防止豁免扩张把环完全藏起来。
    Django_xm.apps.ai_engine.settings_views -> Django_xm.apps.knowledge.services.embedding_service
    Django_xm.apps.ai_engine.settings_views -> Django_xm.apps.knowledge.vector_store.pgvector_backend
    Django_xm.apps.ai_engine.settings_views -> Django_xm.apps.knowledge.services.kb_service
    # 合法中间层首跳边（本契约只约束 ai_engine 的直接反向依赖）：
    # forbidden 契约为传递性检查，以下 ai_engine → 中间层的架构性依赖
    # （tools 工具层 / context_manager 上下文层 / tasks 任务层）是既定分层，
    # 由其自身管理对 knowledge 的依赖，不视为 ai_engine 反向依赖违规。
    Django_xm.apps.ai_engine.capabilities.builtin -> Django_xm.apps.context_manager.middleware
    Django_xm.apps.ai_engine.capabilities.builtin -> Django_xm.apps.context_manager.services.compression
    Django_xm.apps.ai_engine.services.usage_tracker -> Django_xm.apps.context_manager.services.compression
    Django_xm.apps.ai_engine.capabilities.builtin -> Django_xm.apps.tools
    Django_xm.apps.ai_engine.subagent_runtime.adapters.langgraph_adapter -> Django_xm.apps.tools
    Django_xm.apps.ai_engine.services.cross_app -> Django_xm.tasks.chat_tasks

[importlinter:contract:apps-not-dependent-on-services]
name = apps 业务层禁止依赖 services 执行编排层
type = forbidden
source_modules =
    Django_xm.apps
forbidden_modules =
    Django_xm.services
